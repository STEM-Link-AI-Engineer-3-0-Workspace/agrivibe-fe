# Where the AgriVibe backend runs.
AGRIVIBE_API=http://127.0.0.1:8000
# Seconds to wait for one chat turn. Decision questions can take two minutes.
AGRIVIBE_TIMEOUT=180

# The farmer the backend acts for: keep these the same as in agrivibe-be's .env.
# The backend decides who is asking from its own .env; this copy is only shown on the page
# and written to the log. It is never sent to the backend.
FARMER_ID=frm_7f3a9c2e
FARMER_NAME=Nimal Perera
